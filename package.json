{
  "name": "cybergold-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "validate:env": "node scripts/validate-active-env.mjs .env.local",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check:naming": "bash scripts/check-naming.sh",
    "check:docs": "python3 scripts/check-docs.py",
    "check:workflows": "python3 ../cybergold-protocol/ci/check-workflow-pins.py --project-root . --allow-job-write .github/workflows/publish-image.yml:publish:packages",
    "check:release-boundaries": "python3 scripts/check-release-boundaries.py",
    "generate:abis": "node scripts/generate-contract-abis.mjs",
    "check:abis": "node scripts/generate-contract-abis.mjs --check",
    "ci-check": "node scripts/run-ci-checks.mjs",
    "test": "node --env-file-if-exists=.env.local --import ./tests/fixtures/register-server-only.mjs --experimental-strip-types --experimental-specifier-resolution=node --test app/utils/*.test.mts tests/release/*.test.mjs",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:headed": "playwright test tests/e2e --headed",
    "test:e2e:ui": "playwright test tests/e2e --ui",
    "test:deployed": "node scripts/run-trade-regression.mjs",
    "test:e2e:metamask:cache": "node --env-file-if-exists=.env.local scripts/cache-metamask-wallet.mjs",
    "test:e2e:metamask": "playwright test tests/metamask --project=metamask",
    "test:deferred-exact-out": "playwright test --config playwright.deferred-exact-out.config.ts",
    "test:deferred-exact-out:unit": "node --env-file-if-exists=.env.local --import ./tests/fixtures/register-server-only.mjs --experimental-strip-types --experimental-specifier-resolution=node --test tests/deferred-exact-out/unit/*.test.mts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@metamask/sdk": "0.33.1",
    "@nivo/pie": "^0.99.0",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.2.6",
    "@rainbow-me/rainbowkit": "^2.2.9",
    "@tanstack/react-query": "^5.90.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^0.555.0",
    "next": "^16.4.1",
    "next-intl": "^4.7.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.5.0",
    "sonner": "^2.0.7",
    "swr": "^2.3.8",
    "tailwind-merge": "^3.4.0",
    "viem": "^2.40.3",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@synthetixio/synpress-cache": "0.0.14",
    "@synthetixio/synpress-core": "0.0.14",
    "@synthetixio/synpress-metamask": "0.0.14",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.0.6",
    "tailwindcss": "^4",
    "tsup": "8.5.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "patch-package": "8.0.1"
  },
  "overrides": {
    "cuer@0.0.3": {
      "qr": "0.5.5"
    },
    "axios": "1.20.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "form-data": "4.0.6",
    "hono": "4.13.11",
    "postcss": "8.5.23",
    "sharp": "0.35.5",
    "ws@>=8.0.0 <9.0.0": "8.21.0",
    "@synthetixio/synpress-cache": {
      "glob@^10": "10.5.0"
    },
    "tsup": "$tsup",
    "esbuild": "$esbuild",
    "@walletconnect/utils": {
      "query-string": "9.5.1"
    },
    "@metamask/sdk": {
      "uuid": "11.1.1"
    },
    "@metamask/sdk-communication-layer": {
      "uuid": "11.1.1"
    },
    "@metamask/utils": {
      "uuid": "11.1.1"
    },
    "valtio@1.13.2": {
      "use-sync-external-store": "1.6.0"
    },
    "zod": "4.6.7",
    "abitype@>=1.0.0 <2.0.0": "1.3.0"
  },
  "license": "AGPL-3.0-only"
}
