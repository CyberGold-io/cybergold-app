# Copy to .env.local for a direct local App launch. Never commit .env.local.
# These public example values target the shared B2B Mainnet fork (chain 31338).
# Use the Ops profile for other networks or update these values to match them.

# Wallet/network bootstrap. Core, Helpers, Governance, Staking, Safe, adapter
# and the token catalog come from the Backend through /api/protocol/config.
# Browser data uses fixed same-origin product API routes.
NEXT_PUBLIC_CHAIN_ID=31338
NEXT_PUBLIC_CHAIN_NAME="CyberGold Remote B2B Mainnet Fork"

# Wallet network suggestion; separate from the App's same-origin reads.
NEXT_PUBLIC_WALLET_RPC_URL=https://rpc-fork.cybergold.io/

# Public CyberGold project ID from https://dashboard.reown.com for mobile/QR pairing.
# Leave empty for injected browser wallets only. A changed ID needs a new build.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Private connection to the backend API process. No DB/RPC/service credentials
# belong in the frontend. For local backend startup see cybergold-backend.
CYBERGOLD_BACKEND_URL=http://127.0.0.1:3001
# For the deployed API, use https://api.sandbox.cybergold.io (Sandbox) or
# https://api.app.cybergold.io (Mainnet), with the corresponding private token.
# Never prefix this credential with NEXT_PUBLIC_. Local private backends need no token.
CYBERGOLD_BACKEND_BEARER_TOKEN=


# npm run validate:env checks the chain through the running frontend's fixed API.
# On another local port, set NEXT_PUBLIC_APP_ORIGIN for that CLI, for example:
# NEXT_PUBLIC_APP_ORIGIN=http://localhost:4317
# Ops may supply RPC_VALIDATION_URL/RPC_AUTHORIZATION to its validation process;
# these are tooling inputs and are not frontend runtime configuration.
